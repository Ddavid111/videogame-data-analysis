@startuml
top to bottom direction
scale 1.0

skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontSize 13
skinparam titleFontSize 16
skinparam noteFontSize 12
skinparam dpi 180
skinparam wrapWidth 220

skinparam folder {
    BackgroundColor #F7F7F7
    BorderColor #666666
    FontColor #222222
    FontSize 13
}

skinparam rectangle {
    BackgroundColor #FFF4EF
    BorderColor #A64B00
    FontColor #222222
    FontSize 13
    RoundCorner 8
}

skinparam file {
    BackgroundColor white
    BorderColor #777777
    FontColor #222222
    FontSize 12
}

skinparam note {
    BackgroundColor #FFFBEA
    BorderColor #B8A44C
    FontColor #222222
    FontSize 12
}

skinparam arrow {
    Color #444444
    FontColor #222222
    Thickness 1.5
    FontSize 12
}

title Merge folyamat – betöltés és egyesítés lépései

folder "Forrás A\n(Steam CSV-k)" as A {
    file "steam.csv\nsteam_description_data.csv\nsteam_media_data.csv\nsteam_support_info.csv\nsteamspy_tag_data.csv\nsteam_requirements_data.csv" as A_files
}

folder "Forrás B" as B {
    file "games.json" as B_json
}

folder "Forrás C\n(2024–2025 CSV-k)" as C {
    file "games_march2025_cleaned.csv\ngames_march2025_full.csv\ngames_may2024_cleaned.csv\ngames_may2024_full.csv" as C_files
}

A -[hidden]right- B
B -[hidden]right- C

rectangle "**A_merged.csv**\nBelső merge (load_source_a)" as A_merged
rectangle "**B_full.csv**\nJSON feldolgozás (load_source_b)" as B_full
rectangle "**C_combined.csv**\nBelső merge (load_source_c)" as C_combined

A_files --> A_merged
B_json --> B_full
C_files --> C_combined

A_merged -[hidden]right- B_full
B_full -[hidden]right- C_combined

rectangle "**merged_master.csv**\nEgységes relációs séma (D)" as D

note right of D
Forrás-prioritás:
 C → elsődleges
 B → másodlagos
 A → hiánykitöltés
end note

C_combined --> D : 1. lépés
B_full --> D : 2. lépés
A_merged --> D : 3. lépés
@enduml
